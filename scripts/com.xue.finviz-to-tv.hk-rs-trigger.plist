<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pre-EOD dispatch of the update_hk_rs.yml GH Actions workflow, Mon-Fri
  18:45 HKT — 75 min before the HK EOD slot. Same rationale and script as
  the US trigger (see com.xue.finviz-to-tv.us-rs-3m-trigger.plist).

  Install:
    cp scripts/com.xue.finviz-to-tv.hk-rs-trigger.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) \
        ~/Library/LaunchAgents/com.xue.finviz-to-tv.hk-rs-trigger.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.xue.finviz-to-tv.hk-rs-trigger</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/xue/momentum-scanner/scripts/trigger_rs_workflow.sh</string>
        <string>update_hk_rs.yml</string>
        <string>HK</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <!-- Mon-Fri 18:45 HKT -->
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>45</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>WorkingDirectory</key>
    <string>/Users/xue/momentum-scanner</string>
</dict>
</plist>
